cmake_minimum_required(VERSION 3.22)

set(snapshot_cases core-code core-docs core-docs-update platform-code platform-docs
				   platform-docs-update fixture-code fixture-docs fixture-docs-update)
set(test_cases ${snapshot_cases} fixture-all output-options snapshot-checker invalid-arguments)

foreach(required GENERATOR SNAPSHOT_CHECKER REGISTRY_DIR TEST_BINARY_DIR)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
	message(FATAL_ERROR "${required} is required")
  endif()
endforeach()

function(check_snapshot directory snapshot)
  set(update_arg)
  if(UPDATE_SNAPSHOTS)
	set(update_arg --update)
  endif()
  execute_process(
	COMMAND "${SNAPSHOT_CHECKER}" "${directory}"
			"${CMAKE_CURRENT_LIST_DIR}/snapshots/${snapshot}.txt" ${update_arg}
	RESULT_VARIABLE result
	OUTPUT_VARIABLE output
	ERROR_VARIABLE error)
  if(NOT result STREQUAL "0")
	message(FATAL_ERROR "${snapshot}: ${error}\nOutput retained at ${work_dir}")
  endif()
  if(UPDATE_SNAPSHOTS)
	message(STATUS "${output}")
  endif()
endfunction()

function(expect_snapshot_failure diagnostic)
  execute_process(
	COMMAND "${SNAPSHOT_CHECKER}" "${code_dir}"
			"${CMAKE_CURRENT_LIST_DIR}/snapshots/fixture-code.txt"
	RESULT_VARIABLE result
	OUTPUT_VARIABLE output
	ERROR_VARIABLE error)
  if(NOT result STREQUAL "1" OR NOT error MATCHES "${diagnostic}")
	message(FATAL_ERROR "Snapshot checker missed ${diagnostic}: ${result}: ${output}\n${error}")
  endif()
endfunction()

function(run_generator)
  execute_process(
	COMMAND "${GENERATOR}" ${module_args} --work-directory "${input_dir}"
			--core "${core_file}" --formatter= ${ARGN}
	WORKING_DIRECTORY "${work_dir}"
	RESULT_VARIABLE result
	OUTPUT_VARIABLE output
	ERROR_VARIABLE error)
  if(NOT result STREQUAL "0")
	message(FATAL_ERROR "Generator failed (${result}): ${output}\n${error}\nOutput retained at ${work_dir}")
  endif()
endfunction()

function(expect_failure diagnostic)
  execute_process(
	COMMAND "${GENERATOR}" --work-directory "${input_dir}" --core "${core_file}"
			--out:code "${code_dir}" --out:doc "${doc_dir}" --formatter= ${ARGN}
	WORKING_DIRECTORY "${work_dir}"
	RESULT_VARIABLE result
	OUTPUT_VARIABLE output
	ERROR_VARIABLE error)
  if(NOT result STREQUAL "1" OR NOT error MATCHES "${diagnostic}")
	message(FATAL_ERROR "Expected exit 1 and '${diagnostic}', got ${result}: ${output}\n${error}")
  endif()
  if(EXISTS "${code_dir}" OR EXISTS "${doc_dir}")
	message(FATAL_ERROR "Invalid arguments created output directories")
  endif()
endfunction()

if(UPDATE_SNAPSHOTS)
  set(cases ${snapshot_cases})
else()
  if(NOT CASE IN_LIST test_cases)
	message(FATAL_ERROR "Unknown generator test case: ${CASE}")
  endif()
  set(cases ${CASE})
endif()

foreach(current_case IN LISTS cases)
  string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef run_id)
  set(work_dir "${TEST_BINARY_DIR}/runs/${current_case}-${run_id}")
  set(code_dir "${work_dir}/output with spaces/code")
  set(doc_dir "${work_dir}/output with spaces/docs")
  file(MAKE_DIRECTORY "${work_dir}")
  set(module_args)
  set(input_dir "${REGISTRY_DIR}")
  set(core_file wis.xml)
  if(current_case MATCHES "^platform-")
	set(module_args platform)
  elseif(NOT current_case MATCHES "^core-")
	set(input_dir "${CMAKE_CURRENT_LIST_DIR}/fixtures")
	set(core_file registry.xml)
  endif()

  if(current_case STREQUAL "output-options")
	foreach(form short long short-equals long-equals)
	  set(code_path "output with spaces/${form}/code")
	  set(doc_path "output with spaces/${form}/docs")
	  if(form STREQUAL "short")
		set(options -o:c "${code_path}" -o:d "${doc_path}")
	  elseif(form STREQUAL "long")
		set(options --out:code "${work_dir}/${code_path}" --out:doc "${work_dir}/${doc_path}")
	  elseif(form STREQUAL "short-equals")
		set(options "-o:c=${code_path}" "-o:d=${doc_path}")
	  else()
		set(options "--out:code=${code_path}" "--out:doc=${doc_path}")
	  endif()
	  run_generator(${options})
	  check_snapshot("${work_dir}/${code_path}" fixture-code)
	  check_snapshot("${work_dir}/${doc_path}" fixture-docs)
	endforeach()
	elseif(current_case STREQUAL "snapshot-checker")
	run_generator(--out:code "${code_dir}" --out:doc "${doc_dir}" --no-docs)
	set(header "${code_dir}/include/fixture/generated/c_api.h")
	configure_file("${header}" "${work_dir}/original.h" COPYONLY)
	file(APPEND "${header}" "Unexpected change")
	expect_snapshot_failure("Changed output: include/fixture/generated/c_api.h")
	configure_file("${work_dir}/original.h" "${header}" COPYONLY)
	file(REMOVE "${header}")
	expect_snapshot_failure("Missing output: include/fixture/generated/c_api.h")
	configure_file("${work_dir}/original.h" "${header}" COPYONLY)
	configure_file("${header}" "${code_dir}/unexpected.h" COPYONLY)
	expect_snapshot_failure("Unexpected output: unexpected.h")
	file(REMOVE "${code_dir}/unexpected.h")
	check_snapshot("${code_dir}" fixture-code)
  elseif(current_case STREQUAL "invalid-arguments")
	expect_failure("No output selected" --no-code --no-docs)
	foreach(option -o:c -o:d --out:code --out:doc)
	  expect_failure("Missing value" "${option}")
	  expect_failure("must not be empty" "${option}=")
	endforeach()
	foreach(option --no-code=true --no-docs=false --no-code-extra --no-doc)
	  expect_failure("Invalid argument" "${option}")
	endforeach()
  else()
	set(mode_args)
	if(current_case MATCHES "-code$")
	  set(mode_args --no-docs)
	elseif(current_case MATCHES "-docs(-update)?$")
	  set(mode_args --no-code)
	endif()
	if(current_case STREQUAL "fixture-docs-update")
	  file(MAKE_DIRECTORY "${doc_dir}/fixture/struct")
	  configure_file("${CMAKE_CURRENT_LIST_DIR}/fixtures/handwritten.h"
					 "${doc_dir}/fixture/struct/test_config_struct.h" COPYONLY)
	elseif(current_case MATCHES "-docs-update$")
	  run_generator(--out:code "${code_dir}" --out:doc "${doc_dir}" --no-code)
	endif()

	run_generator(--out:code "${code_dir}" --out:doc "${doc_dir}" ${mode_args})
	if(current_case MATCHES "-code$")
	  if(EXISTS "${doc_dir}")
		message(FATAL_ERROR "--no-docs created a documentation directory")
	  endif()
	  check_snapshot("${code_dir}" "${current_case}")
	elseif(current_case MATCHES "-docs(-update)?$")
	  if(EXISTS "${code_dir}")
		message(FATAL_ERROR "--no-code created a code directory")
	  endif()
	  check_snapshot("${doc_dir}" "${current_case}")
	else()
	  check_snapshot("${code_dir}" fixture-code)
	  check_snapshot("${doc_dir}" fixture-docs)
	endif()

	if(current_case STREQUAL "fixture-docs-update")
	  file(READ "${doc_dir}/fixture/struct/test_config_struct.h" documentation)
	  foreach(text "Handwritten introduction." "Handwritten middle section." "Handwritten conclusion.")
		string(FIND "${documentation}" "${text}" position)
		if(position EQUAL -1)
		  message(FATAL_ERROR "Documentation update removed '${text}'")
		endif()
	  endforeach()
	  foreach(text OLD_CODE OLD_DESCRIPTION OLD_VALIDATION OLD_REFERENCES)
		string(FIND "${documentation}" "${text}" position)
		if(NOT position EQUAL -1)
		  message(FATAL_ERROR "Documentation update did not replace '${text}'")
		endif()
	  endforeach()
	endif()
  endif()

	if(UPDATE_SNAPSHOTS)
	message(STATUS "Generated output retained at ${work_dir}")
  else()
	file(REMOVE_RECURSE "${work_dir}")
  endif()
endforeach()